{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "types:api": "openapi-typescript docs/architecture/api/openapi.yaml -o resources/js/types/generated/api.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/js/**/*.{ts,vue,css}\"",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "e2e": "playwright test",
        "e2e:smoke": "playwright test --grep @smoke",
        "e2e:server": "bash e2e/server.sh"
    },
    "dependencies": {
        "@lucide/vue": "^1.55.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "pinia": "^3.0.0",
        "tailwind-merge": "^3.0.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^10.0.3",
        "eslint": "^9.18.0",
        "eslint-plugin-vue": "^10.0.0",
        "jsdom": "^26.0.0",
        "laravel-echo": "^2.6.1",
        "laravel-vite-plugin": "^3.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.4.0",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^8.0.0",
        "vitest": "^4.0.0",
        "vue-tsc": "^2.2.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
