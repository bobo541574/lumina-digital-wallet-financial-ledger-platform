APP_NAME="Lumina Wallet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lumina
DB_USERNAME=postgres
DB_PASSWORD=

# PostgreSQL server-side guard rails (milliseconds; 0 disables)
DB_STATEMENT_TIMEOUT=0
DB_IDLE_TRANSACTION_TIMEOUT=0

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime notifications. Set BROADCAST_CONNECTION=reverb and fill the REVERB_*
# credentials below to push in-app notifications over WebSockets (php artisan
# reverb:start). The default no-op driver keeps notification payloads out of the
# logs; the SPA falls back to polling whenever VITE_REVERB_APP_KEY is empty.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Frontend build/deploy. Leave VITE_API_BASE_URL empty for a same-origin SPA
# (default `/api/v1`); set it to an absolute URL for split-host deployments.
# VITE_BUILD_SOURCEMAP makes `npm run build` emit source maps (default off).
VITE_API_BASE_URL=
VITE_BUILD_SOURCEMAP=false

# Response hardening. CSP is off by default (enable in production once verified);
# it is nonce-based and allows the Vite tags plus the inline theme bootstrap.
SECURITY_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=false
SECURITY_CSP_REPORT_ONLY=true
SECURITY_CSP_CONNECT_EXTRA=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Security: request rate limits (requests per minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_WEBHOOKS=120
RATE_LIMIT_MONEY=60
RATE_LIMIT_ADMIN=120

# Security: two-factor authentication (TOTP)
TWO_FACTOR_ISSUER="${APP_NAME}"
TWO_FACTOR_WINDOW=1
TWO_FACTOR_RECOVERY_CODES=8
SECURITY_ADMIN_MFA_REQUIRED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FAKE_PAYMENT_PROVIDER_SECRET=fake-provider-secret

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
